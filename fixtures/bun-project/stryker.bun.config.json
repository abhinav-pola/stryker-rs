{
  "testRunner": "bun",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "app/[(]group[)]/**/*.ts"
  ],
  "ignorePatterns": [
    "node_modules"
  ],
  "concurrency": 2,
  "timeoutMS": 5000,
  "inPlace": true,
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/bun.json"
  },
  "cleanTempDir": true,
  "htmlReporter": {
    "fileName": "reports/mutation/bun.html"
  },
  "incremental": true,
  "incrementalFile": "reports/mutation/bun.incremental.json"
}